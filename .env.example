# API
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DEMO_USER_EMAIL=demo@academic-collab.local
DEMO_USER_NAME=Demo Student
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academic_collab?schema=public

# Redis (reserved for background jobs and collaboration presence)
REDIS_URL=redis://localhost:6379

# S3-compatible local object storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=academic-collab
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniosecret
S3_FORCE_PATH_STYLE=true

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
